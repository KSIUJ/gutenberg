server {
    listen 80;

    # Log format for untrusted proxy errors is defined at http level (generated by entrypoint script)
    # Use conditional access log based on $is_trusted_proxy value
    access_log /dev/stderr gutenberg_untrusted_proxy if=$untrusted_proxy_access;

    # Reject ALL requests from non-trusted sources
    # This applies to the entire application: backend, static files, and docs
    # Returns 400 Bad Request to avoid leaking network configuration details
    if ($is_trusted_proxy = 0) {
        return 400;
    }

    include /etc/nginx/gutenberg-locations.d/*.conf;
}
